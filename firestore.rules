rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔒 Helpers de rol — MODELO RBAC OFICIAL OPERACIONES LCT 🔒
    function isAuth() {
      return request.auth != null;
    }
    function hasUserDoc() {
      return isAuth() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function userRole() {
      return hasUserDoc() ? userDoc().get('rol', 'operador') : 'operador';
    }

    function isSuperAdmin() {
      return isAuth() && (!hasUserDoc() || userRole() == 'super_admin');
    }
    function isAdmin() {
      return isAuth() && (!hasUserDoc() || userRole() == 'admin' || userRole() == 'super_admin');
    }
    function isAdminZona() {
      return isAuth() && (
        isAdmin() ||
        userRole() == 'admin_zona' ||
        userRole() == 'admin_zona_cocina' ||
        userRole() == 'admin_zona_produccion' ||
        userRole() == 'admin_sec' ||
        userRole() == 'jefe_zona'
      );
    }
    function isOperador() {
      return true;
    }
    function isOperadorCocina() {
      return true;
    }

    // ── Usuarios & Users ────────────────────────────────────────────────────────
    match /usuarios/{uid} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    match /users/{userId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // ── Sucursales ─────────────────────────────────────────────────────────────
    match /sucursales/{branchId} {
      allow read, write: if true;
    }

    // ── Conteos de Caja ────────────────────────────────────────────────────────
    match /conteos/{conteoId} {
      allow read, write: if true;
    }

    // ── Bitácora de Auditoría ──────────────────────────────────────────────────
    match /bitacora/{logId} {
      allow read, create: if true;
      allow update, delete: if false; // Inmutable
    }

    // ── Configuración Global ───────────────────────────────────────────────────
    match /configuracion/{docId} {
      allow read, write: if true;
    }

    // ── Checklists de Cocina ──────────────────────────────────────────────────
    match /cocina_checklists/{docId} {
      allow read, write: if true;
    }

    match /actividades_cocina/{docId} {
      allow read, write: if true;
    }

    // ── Tarjetas y Configuración de Cocina ─────────────────────────────────────
    match /cocina_tarjetas_config/{branchId} {
      allow read, write: if true;
    }

    // ── Inventarios y Control de Cocina ───────────────────────────────────────
    match /cocina_inventarios/{docId} {
      allow read, write: if true;
    }

    // ── Checklists de Producción ──────────────────────────────────────────────
    match /produccion_checklists/{docId} {
      allow read, write: if true;
    }

    // ── Incidencias de Capitanes ───────────────────────────────────────────────
    match /incidencias_capitanes/{docId} {
      allow read, write: if true;
    }

    // ── Ventas por Hora ────────────────────────────────────────────────────────
    match /registros_ventas/{docId} {
      allow read, write: if true;
    }

    // ── Registro de Etiquetas 🔴🟡🔵 ──────────────────────────────────────────
    match /etiquetas_registros/{docId} {
      allow read, write: if true;
    }

    // ── Stocks e Inventarios Diarios ──────────────────────────────────────────
    match /stocks_productos/{docId} {
      allow read, write: if true;
    }
    match /inventario_diario/{docId} {
      allow read, write: if true;
    }
    match /refrescos_catalogo/{sucursalId} {
      allow read, write: if true;
    }
    match /productos_catalogo/{tipo} {
      allow read, write: if true;
    }
    match /refrescos_semanas/{docId} {
      allow read, write: if true;
    }
    match /notificaciones/{docId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }
    match /auditorias/{docId} {
      allow read, write: if true;
    }
    match /reportes_nocturnos/{docId} {
      allow read, write: if true;
    }
    match /uniforme_reportes/{docId} {
      allow read, write: if true;
    }
    match /auditoria_uso/{docId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    match /checklist_templates/{docId} {
      allow read, write: if true;
    }
    match /apoyos_visuales_cocina/{docId} {
      allow read, write: if true;
    }
    match /autorizaciones_apoyos/{docId} {
      allow read, write: if true;
    }
    match /auditoria_apoyos/{docId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    match /studio_builder_modules/{docId} {
      allow read, write: if true;
    }
    match /studio_builder_versions/{docId} {
      allow read, write: if true;
    }
    match /studio_builder_responses/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /studio_builder_audit/{docId} {
      allow read, create: if true;
    }
    match /sheets_queue/{docId} {
      allow read, create: if true;
    }
    match /asistencias_turnos/{docId} {
      allow read, write: if true;
    }
    match /cortes_diarios/{docId} {
      allow read, write: if true;
    }
    match /abastecimiento_reportes/{docId} {
      allow read, write: if true;
    }
    match /abastecimiento_catalogos/{docId} {
      allow read, write: if true;
    }

    // ── Atlas Long-Term Memory (Contexto, Preferencias e Historial del Agente) ──
    match /atlas_memory/{userId} {
      allow read, write: if true;
      
      match /actions/{actionId} {
        allow read, write: if true;
      }

      match /{subCollection=**} {
        allow read, write: if true;
      }
    }
  }
}
